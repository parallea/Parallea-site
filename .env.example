PORT=3001

# Local testing: set to true to simulate success without sending an email.
WAITLIST_DRY_RUN=false

# SMTP settings from your transactional email provider or workspace mail server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Waitlist sender configuration.
WAITLIST_FROM_NAME=Ayush Kumar Bhardwaj
WAITLIST_FROM_EMAIL=ayush@paralleatech.com
WAITLIST_REPLY_TO=ayush@paralleatech.com

# Optional: send yourself a notification whenever someone joins.
WAITLIST_NOTIFICATION_TO=
